# Local development defaults only. Use a managed PostgreSQL URL and secure cookies in production.
DATABASE_URL=sqlite:///./omnishelf-dev.db
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Disable verification only for private localhost development. Hosted signup must require verification.
EMAIL_VERIFICATION_REQUIRED=false
SESSION_TTL_SECONDS=2592000
FRONTEND_ORIGIN=http://127.0.0.1:8000
PUBLIC_APP_ORIGIN=http://127.0.0.1:8000
MAX_STATE_BYTES=20971520

# Local SMTP is the default for private development. Render Free uses Resend's HTTPS API (port 443).
EMAIL_DELIVERY_PROVIDER=smtp
RESEND_API_KEY=

# Optional local SMTP. Configure all required fields and set EMAIL_VERIFICATION_REQUIRED=true to exercise email flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OmniShelf
SMTP_STARTTLS=true
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800

# Hosted-only migration safety guard. Set these in the private Render environment
# only after independently confirming the intended database endpoint and database name.
# Leave blank for local development; do not copy DATABASE_URL into source or chat.
OMNISHELF_EXPECTED_DATABASE_HOST=
OMNISHELF_EXPECTED_DATABASE_NAME=

# One-off email delivery acceptance: leave disabled except during an explicit staging test.
# For Render Free, use the Resend HTTPS API and its documented simulated-delivery test recipient.
OMNISHELF_SMTP_ACCEPTANCE_ENABLED=false
SMTP_TEST_RECIPIENT=
